{
  "agent": "orquestador",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(python3 scripts/registro.py *)",
      "Bash(python3 scripts/pipeline.py *)",
      "Bash(python3 scripts/render_carrusel.py *)",
      "Bash(python3 -c *)",
      "Bash(python3 -m playwright install chromium)",
      "Bash(pip install playwright)",
      "Bash(pip install --user playwright)",
      "Bash(pip3 install playwright)",
      "Bash(pip3 install --user playwright)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(npx create-video@latest *)",
      "Bash(npx remotion *)",
      "Bash(npx skills add remotion-dev/skills*)",
      "Bash(npm install*)",
      "Bash(npm ls*)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm -r video/public/prueba*)",
      "Bash(rm -r video/out*)",
      "Bash(rm -r carruseles/prueba*)",
      "Bash(rm video/public/*)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(date*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push*)",
      "Bash(rm brutos*)",
      "Bash(rm -r brutos*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger.py\""
          }
        ]
      }
    ]
  }
}
